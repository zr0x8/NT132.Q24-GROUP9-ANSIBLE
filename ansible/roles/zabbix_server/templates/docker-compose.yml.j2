services:
  postgres:
    image: {{ zabbix_postgres_image }}
    container_name: zbx-postgres
    environment:
      POSTGRES_USER: {{ zabbix_db_user }}
      POSTGRES_PASSWORD: {{ zabbix_db_password }}
      POSTGRES_DB: {{ zabbix_db_name }}
    volumes:
      - pg_data:/var/lib/postgresql/data
    restart: unless-stopped

  zabbix-server:
    image: {{ zabbix_server_image }}
    container_name: zbx-server
    environment:
      DB_SERVER_HOST: postgres
      POSTGRES_USER: {{ zabbix_db_user }}
      POSTGRES_PASSWORD: {{ zabbix_db_password }}
      POSTGRES_DB: {{ zabbix_db_name }}
    depends_on:
      - postgres
    ports:
      - "{{ zabbix_server_port }}:10051"
    restart: unless-stopped

  zabbix-web:
    image: {{ zabbix_web_image }}
    container_name: zbx-web
    environment:
      DB_SERVER_HOST: postgres
      POSTGRES_USER: {{ zabbix_db_user }}
      POSTGRES_PASSWORD: {{ zabbix_db_password }}
      POSTGRES_DB: {{ zabbix_db_name }}
      ZBX_SERVER_HOST: zabbix-server
      PHP_TZ: {{ zabbix_timezone }}
    depends_on:
      - zabbix-server
    ports:
      - "{{ zabbix_web_port }}:8080"
    restart: unless-stopped

volumes:
  pg_data:
